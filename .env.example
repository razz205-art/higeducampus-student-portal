# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/lms_portal?schema=public"

# --- NextAuth / Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# --- Resend (transactional email) ---
# https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="LMS Portal <no-reply@yourdomain.edu>"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: restrict self-registration to a domain (leave blank to allow any) ---
ALLOWED_STUDENT_EMAIL_DOMAIN=""

# --- Seed script (used once by `npm run prisma:seed`) ---
SEED_SUPER_ADMIN_EMAIL="superadmin@lms-portal.edu"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!12345"
