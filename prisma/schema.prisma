generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ACADEMIC_ADMIN
  SUPER_ADMIN
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String? // null for OAuth-only accounts
  role               Role      @default(STUDENT)
  isActive           Boolean   @default(true)
  registrationNumber String?   @unique // students only; used on the attendance check-in form
  batchId            String?

  // Brute-force protection
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions             Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs            AuditLog[]

  // Attendance module
  batch              Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  facultyCourses     Course[]           @relation("FacultyCourses")
  coFacultyCourses   CourseFaculty[]    @relation("CoFacultyCourses")
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[] @relation("StudentAttendance")
  markedAttendance   AttendanceRecord[] @relation("MarkedByFaculty")
  liveClassSessions  LiveClassSession[] @relation("FacultyLiveSessions")

  // Progress tracker module
  lessonCompletions     LessonCompletion[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  // Exam countdown module
  createdExams Exam[] @relation("ExamCreatedBy")

  // Notification center module
  createdNotifications Notification[]     @relation("NotificationCreatedBy")
  notificationReads    NotificationRead[]

  // Timetable module
  createdTimetableSlots TimetableSlot[] @relation("TimetableCreatedBy")

  // Results module
  semesterResults        SemesterResult[] @relation("StudentSemesterResults")
  createdSemesterResults SemesterResult[] @relation("SemesterResultCreatedBy")
  createdTestReports TestReport[]      @relation("TestReportCreatedBy")
  testReportEntries  TestReportEntry[] @relation("StudentTestReportEntries")
  // Certificate module
  certificates Certificate[]

  // Study materials module
  uploadedMaterials StudyMaterial[]

  @@index([role])
  @@index([batchId])
  @@map("users")
}

// Required by @auth/prisma-adapter for OAuth (Google) linkage
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Custom table for forgot/reset password flow. We store a HASH of the
// token, never the raw token, and enforce single-use + expiry.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Lightweight audit trail for security-sensitive auth events.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String // e.g. LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_RESET_REQUESTED, ROLE_DENIED
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([userId])
  @@map("audit_logs")
}

// Attendance module — minimal Course/Enrollment layer exists only to give
// attendance something to attach to (which student, in which course, marked
// by which faculty member). There is no course-catalog UI yet; courses are
// provisioned by an admin (e.g. via Prisma Studio) until that module ships.
model Course {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  facultyId String
  createdAt DateTime @default(now())

  faculty     User               @relation("FacultyCourses", fields: [facultyId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  liveClassSessions LiveClassSession[]
  modules     Module[]
  quizzes     Quiz[]
  assignments Assignment[]
  timetableSlots TimetableSlot[]
  semesterCourseResults SemesterCourseResult[]
  certificates          Certificate[]
  materials             StudyMaterial[]
  additionalFaculty     CourseFaculty[]
  notifications         Notification[]

  @@index([facultyId])
  @@map("courses")
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

// How an attendance row was created — for audit clarity, not access control.
enum AttendanceSource {
  FACULTY_ENTRY
  SELF_CHECKIN
  ADMIN_CORRECTION
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  studentId  String
  courseId   String
  date       DateTime         @db.Date
  status     AttendanceStatus
  notes      String?
  markedById String
  source     AttendanceSource @default(FACULTY_ENTRY)
  sessionId  String? // set when created via the live-class self check-in form
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student  User              @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  course   Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  markedBy User              @relation("MarkedByFaculty", fields: [markedById], references: [id], onDelete: Cascade)
  session  LiveClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // One status per student, per course, per day — this also doubles as the
  // "no duplicate check-in" constraint for the self-checkin flow, since a
  // check-in and a manual entry for the same day collide on this key.
  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId, date])
  @@index([sessionId])
  @@map("attendance_records")
}

model Batch {
  id        String @id @default(cuid())
  name      String @unique // e.g. "2024 - 2028"
  startYear Int
  endYear   Int

  students          User[]
  liveClassSessions LiveClassSession[]
  timetableSlots    TimetableSlot[]
  notifications     Notification[]

  @@map("batches")
}

enum MeetingPlatform {
  ZOOM
  GOOGLE_MEET
}

// A faculty-created live class. Faculty create these (isActive: false by
// default); an Admin then activates exactly one at a time via
// setActiveSessionAction, which is what actually opens the public
// check-in form at /attendance. There is no separate "attendance link per
// session" — the link is permanent, and it always resolves to whichever
// session (if any) is currently active.
model LiveClassSession {
  id           String          @id @default(cuid())
  courseId     String
  batchId      String? // if set, only students in this batch may check in
  facultyId    String
  subjectLabel String? // defaults to the course name when displayed if unset
  date         DateTime        @db.Date
  startTime    String // "HH:MM", display-only — the window is opened/closed manually
  platform     MeetingPlatform
  meetingLink  String
  isActive     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  course             Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch              Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  faculty            User               @relation("FacultyLiveSessions", fields: [facultyId], references: [id], onDelete: Cascade)
  attendanceRecords  AttendanceRecord[]

  @@index([courseId])
  @@index([facultyId])
  @@index([isActive])
  @@map("live_class_sessions")
}

// Progress tracker module — Module/Lesson give course content something to
// track completion against; Quiz/Assignment give the tracker real score
// and submission data to summarize. There is no content-authoring or
// quiz-taking/assignment-submission UI yet (that's its own future module);
// these rows are provisioned by an admin/faculty member (e.g. via Prisma
// Studio) the same way Course/Enrollment are today, and the seed script's
// demo data extension populates a realistic set for local development.
model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  materials StudyMaterial[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  order     Int
  createdAt DateTime @default(now())

  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonCompletion {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  completedAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@map("lesson_completions")
}

enum AssessmentKind {
  INTERNAL
  MOCK_TEST
}

model Quiz {
  id        String         @id @default(cuid())
  courseId  String
  title     String
  maxScore  Int            @default(100)
  kind      AssessmentKind @default(MOCK_TEST)
  createdAt DateTime       @default(now())

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  studentId String
  quizId    String
  score     Int
  takenAt   DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Assignment {
  id             String        @id @default(cuid())
  courseId       String
  title          String
  instructions   String?       @db.Text
  dueDate        DateTime      @db.Date
  maxScore       Int           @default(100)
  attachmentUrl  String?
  attachmentType MaterialType?
  createdAt      DateTime      @default(now())

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@map("assignments")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  studentId      String
  assignmentId   String
  submissionUrl  String?
  submissionNote String?          @db.Text
  submittedAt    DateTime         @default(now())
  status         SubmissionStatus @default(SUBMITTED)
  score          Int?

  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

// Exam countdown module — standalone from Course (CUET PG, UGC NET, etc.
// are institution-wide exams, not tied to a single enrolled course).
// examDate is a real timestamp (not @db.Date) since the countdown needs
// hour/minute/second precision.
model Exam {
  id          String   @id @default(cuid())
  title       String
  description String?
  examDate    DateTime
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([examDate])
  @@index([isActive])
  @@map("exams")
}

// Notification center — institution-wide broadcast messages, authored by
// Academic Admin / Super Admin, visible to every role. Attachments are
// stored as URL references (image/PDF/video hosted externally), not file
// uploads: this project has no storage provider configured (S3/R2/
// Cloudinary etc.) — adding real upload handling is a legitimate future
// infrastructure decision, not something to fake with local disk storage
// in a serverless-friendly app. Read status is per-user, via a join table,
// since a notification is broadcast to many users at once.
enum NotificationCategory {
  ANNOUNCEMENT
  EXAM_UPDATE
  SCHEDULE_CHANGE
  ASSIGNMENT_REMINDER
  FEE_REMINDER
  HOLIDAY_NOTICE
  PLACEMENT_UPDATE
}

enum AttachmentType {
  IMAGE
  PDF
  VIDEO
}

model Notification {
  id          String               @id @default(cuid())
  title       String
  body        String               @db.Text
  category    NotificationCategory
  isPinned    Boolean              @default(false)
  courseId    String? // set -> visible only to that course's students/faculty; null -> general
  batchId     String? // set -> visible only to that batch's students; null -> general
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy   User                     @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  course      Course?                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch       Batch?                   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attachments NotificationAttachment[]
  reads       NotificationRead[]

  @@index([category])
  @@index([isPinned])
  @@index([createdAt])
  @@index([courseId])
  @@index([batchId])
  @@map("notifications")
}

model NotificationAttachment {
  id             String         @id @default(cuid())
  notificationId String
  type           AttachmentType
  url            String
  label          String?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_attachments")
}

model NotificationRead {
  id             String   @id @default(cuid())
  userId         String
  notificationId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("notification_reads")
}

// Timetable module — a RECURRING weekly schedule (e.g. "CS101 meets Mon/
// Wed/Fri 9:00-10:30"), distinct from LiveClassSession (a one-off live
// class instance used for attendance check-in). Subject and Faculty are
// derived from the linked Course, not duplicated here. There is no
// per-occurrence exception model (e.g. "cancel just this Wednesday") —
// isActive turns a slot off for every future week, not a single date.
// That is a deliberate scope decision, flagged here and in the module's
// summary, not an oversight.
model TimetableSlot {
  id          String   @id @default(cuid())
  courseId    String
  batchId     String? // if set, only shown to students in this batch
   topic       String? // e.g. "Chapter 4: Cognitive Development" — shown highlighted on the class card
   specificDate DateTime? @db.Date // if set, this is a one-time class on exactly this date, ignoring dayOfWeek recurrence
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startTime   String // "HH:MM", 24-hour
  endTime     String // "HH:MM", 24-hour
  location    String?
  meetingLink String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch     Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy User   @relation("TimetableCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([dayOfWeek])
  @@map("timetable_slots")
}

// Results module — Internal Results and Mock Tests are read from the
// existing Quiz/QuizAttempt data (differentiated by Quiz.kind), and
// Assignments from the existing AssignmentSubmission data — reused, not
// duplicated. SemesterResult is the one genuinely new entity: the
// official, admin-published record for a student's semester (GPA,
// percentage, per-course grades), which Batch Rank is computed from.
enum ResultStatus {
  PASS
  FAIL
  PENDING
}

model SemesterResult {
  id            String       @id @default(cuid())
  studentId     String
  semesterLabel String // e.g. "Semester 1"
  gpa           Float
  percentage    Float
  status        ResultStatus @default(PASS)
  publishedAt   DateTime     @default(now())
  createdById   String

  student       User                   @relation("StudentSemesterResults", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy     User                   @relation("SemesterResultCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  courseResults SemesterCourseResult[]

  @@unique([studentId, semesterLabel])
  @@index([studentId])
  @@map("semester_results")
}

model SemesterCourseResult {
  id               String @id @default(cuid())
  semesterResultId String
  courseId         String
  marksObtained    Float
  maxMarks         Float
  grade            String // "A", "B+", etc.

  semesterResult SemesterResult @relation(fields: [semesterResultId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([semesterResultId])
  @@map("semester_course_results")
}
model TestReport {
  id                String   @id @default(cuid())
  title             String
  courseId          String
  batchId           String
  passingPercentage Float    @default(60)
  createdById       String
  createdAt         DateTime @default(now())

  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch     Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy User              @relation("TestReportCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  entries   TestReportEntry[]

  @@index([createdAt])
  @@index([courseId])
  @@index([batchId])
  @@map("test_reports")

}

model TestReportEntry {
  id           String  @id @default(cuid())
  testReportId String
  studentId    String?
  name         String
  rank         Int
  percentage   Float
  correct      Int?
  incorrect    Int?
  timeRaw      String?
  status       String

  testReport TestReport @relation(fields: [testReportId], references: [id], onDelete: Cascade)
  student    User?      @relation("StudentTestReportEntries", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([testReportId])
  @@index([studentId])
  @@map("test_report_entries")
}

// Certificate module — issued on demand once a student reaches 100%
// lesson completion in a course (see lib/data/progress.ts's completion
// calculation, reused rather than duplicated). Student name and course
// name are snapshotted at issuance so a certificate's wording never
// silently changes if the student later edits their profile or an admin
// renames a course. verificationCode is the secret-ish token embedded in
// the QR code / public verification URL — deliberately separate from the
// human-readable certificateNumber printed on the certificate itself.
model Certificate {
  id                String    @id @default(cuid())
  studentId         String
  courseId          String
  certificateNumber String    @unique
  verificationCode  String    @unique
  studentName       String
  courseName        String
  courseCode        String
  issuedAt          DateTime  @default(now())
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([verificationCode])
  @@map("certificates")
}

// Study materials — admin/faculty-provisioned reference material per
// course. Files are URL references, same reasoning as Notification
// attachments: no storage provider (S3/R2/Cloudinary) is configured in
// this project, so a real upload flow is a deliberate future addition,
// not something to fake with local disk storage.
enum MaterialType {
  DOCUMENT
  VIDEO
  LINK
}

model StudyMaterial {
  id           String       @id @default(cuid())
  courseId     String
  moduleId     String? // "chapter" — reuses the existing Module model, not a new concept
  title        String
  description  String?
  type         MaterialType
  url          String
  fileSize     String? // admin-entered display string (e.g. "2.4 MB") — materials are URL
  // references, not real uploads, so there is no file to introspect for a real size
  uploadedById String
  createdAt    DateTime     @default(now())

  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
  @@map("study_materials")
}

// Additional faculty co-teaching a course, beyond Course.facultyId (the
// original "primary" faculty field, kept unchanged so nothing already
// built around a single-faculty assumption breaks). Every function that
// decides "does this faculty member have access to this course" — course
// listings, attendance ownership, timetable, the faculty dashboard —
// checks both facultyId and this table, so a co-faculty member gets full
// access, not just a cosmetic name on a list.
model CourseFaculty {
  id        String   @id @default(cuid())
  courseId  String
  facultyId String
  createdAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty User   @relation("CoFacultyCourses", fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyId])
  @@index([facultyId])
  @@map("course_faculty")
}
