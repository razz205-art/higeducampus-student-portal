model Batch {
  id        String @id @default(cuid())
  name      String @unique // e.g. "2024 - 2028"
  startYear Int
  endYear   Int

  students          User[]
  studentBatches    StudentBatch[] // full multi-batch membership — see User.studentBatches
  liveClassSessions LiveClassSession[]
  timetableSlots    TimetableSlot[]
testReports       TestReport[]
courseBatches CourseBatch[]
  notifications     Notification[]

  @@map("batches")
}

// Join table giving a student standing membership in a batch. A student can
// belong to any number of batches (e.g. re-taking a paper alongside a
// younger cohort). User.batchId/batch is kept as a single "primary" batch
// for parts of the app not yet migrated to check this full set — see the
// comment on User.studentBatches.
model StudentBatch {
  id        String   @id @default(cuid())
  studentId String
  batchId   String
  createdAt DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId])
  @@index([batchId])
  @@map("student_batches")
}
